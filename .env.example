# ============================================================================
# UGES SD Kontrol — Örnek Ortam Ayarları (.env.example)
# Kopyalayıp .env olarak kaydedin ve kendi bilgisayarınıza göre düzenleyin.
# ============================================================================

# --- 1. PostgreSQL Veritabanı Ayarları ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ud_kokpit
DB_USER=postgres
DB_PASSWORD=563563
DB_SCHEMA=sd

# --- 2. Python Tam Yolu (SAP VA01 otomasyonu için) ---
PYTHON_EXE=C:\Python312\python.exe

# --- 3. SAP GUI Bağlantı Ayarları ---
SAP_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
SAP_CONNECTION=KKP CANLI
SAP_CLIENT=500
SAP_LANGUAGE=TR
SAP_DEFAULT_SPART=10

# --- 4. Uygulama Port ve Veri Klasörü Ayarları ---
BACKEND_PORT=5100
MCP_PORT=5101
FRONTEND_PORT=3100
SD_DATA_DIR=

# --- 5. Bağımsız MCP Sunucu Ayarları (LLM Suite Flow -> MCP Tools bağlantısı) ---
MCP_API_KEY=
MCP_PUBLIC_URL=
MCP_SQL_ENABLED=true

# --- 6. ASELSAN LLM Suite Flow Ayarları (/api/v1/run/{flowId}) ---
LLMSUITE_BASE_URL=https://llmsuiteflow.aiplatform.aselsan.com.tr
LLMSUITE_FLOW_ID=
LLMSUITE_API_KEY=
LLMSUITE_TIMEOUT_SEC=300
LLMSUITE_CHAT_INPUT_ID=
LLMSUITE_SSL_DOGRULA=true

# --- 7. Doğrudan ASELSAN AI (aselixai) Ayarları (Boşsa Kokpit ai_config kullanılır) ---
# Milli Ağ: https://api.aselixai.aselsan.com.tr/v1
# Aynet   : https://agate.aselsan.com.tr/send/milli/api.aselixai/v1
# Modeller: Qwen3-Next-80B-A3B-Instruct | Qwen3.6-Flash-Next-FP8 | DeepSeek-V4.1-Flash-1017 | openai/gpt-oss-120b | gemma-4-31B-it | Qwen3-VL-8B-Instruct
AI_PROVIDER=ASELSAN AI
AI_API_URL=https://api.aselixai.aselsan.com.tr/v1
AI_API_KEY=
AI_MODEL=Qwen3-Next-80B-A3B-Instruct
